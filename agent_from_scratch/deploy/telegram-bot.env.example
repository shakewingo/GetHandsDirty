# Copy this file to deploy/telegram-bot.env (gitignored — never commit real values) and fill
# in the values below. See agent_from_scratch/README.md for how to obtain them.

# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Your own numeric Telegram user ID (e.g. from @userinfobot). Only this user's messages
# are ever executed; every other sender is silently ignored.
TELEGRAM_ALLOWED_USER_ID=

# Optional. Defaults to ./outputs/telegram_sessions (relative to the repository root).
TELEGRAM_STATE_DIR=

# Optional. Absolute path to the Python that has this project's dependencies, e.g. a conda
# env's bin/python. Defaults to <repo>/.venv/bin/python if it exists, otherwise python3.
PYTHON=
